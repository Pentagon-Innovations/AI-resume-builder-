<html lang="en">

<head>
  <style data-emotion="cl-internal" data-s=""></style>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/vite.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Resume Builder</title>
  <base href="/" />
  <style>
    * {
      box-sizing: border-box;
      overflow-wrap: break-word;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
    }

    .resume {
      width: 100%;
      background: #fff;
      padding: 40px;
      min-height: 296mm;
    }

    .header {
      text-align: center;
      border-bottom: 2px solid #333;
      padding-bottom: 15px;
      margin-bottom: 20px;
    }

    .header h1 {
      font-size: 2rem;
      margin: 0;
      text-transform: uppercase;
    }

    .header p {
      margin: 5px 0;
      font-size: 0.9rem;
    }

    .section {
      margin-bottom: 20px;
      page-break-inside: avoid;
    }

    .section h3 {
      font-size: 1.2rem;
      text-transform: uppercase;
      border-bottom: 1px solid #eee;
      padding-bottom: 5px;
      margin-bottom: 10px;
    }

    .item {
      margin-bottom: 10px;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      font-weight: bold;
      font-size: 0.95rem;
    }

    .item-sub {
      display: flex;
      justify-content: space-between;
      font-style: italic;
      font-size: 0.85rem;
      color: #666;
    }

    .description {
      font-size: 0.85rem;
      margin-top: 5px;
    }

    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill-tag {
      background: #eee;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
    }
  </style>
</head>

<body>
  <div style="background-color: #f7fafc; padding: 24px;">
    <div
      style="max-width: 900px; margin: 0 auto; background-color: white; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); border-radius: 8px; padding: 32px; display: flex;">

      <!-- Left Column -->
      <div style="width: 65%; padding-right: 24px;">
        <h1 style="font-size: 24px; font-weight: bold; color: #2d3748;">{{firstName}} {{lastName}}</h1>
        <h3 style="font-size: 20px; color: #4a5568;">{{jobTitle}}</h3>

        <!-- Personal Summary -->
        <div style="margin-top: 16px;">
          <h2 style="font-size: 18px; font-weight: bold; color: #4a5568;">Personal Summary</h2>
          <p style="color: #718096; margin-top: 8px;">{{summery}}</p>
        </div>

        <!-- Experience -->
        {{#if experience.length}}
        <div style="margin-top: 24px;">
          <h2 style="font-size: 18px; font-weight: bold; color: #4a5568;">Experience</h2>
          {{#each experience}}
          <div style="margin-top: 16px; border-left: 4px solid #4299e1; padding-left: 16px;">
            <h3 style="font-size: 16px; font-weight: bold;">{{title}} - {{companyName}}</h3>
            <p style="color: #718096; font-size: 14px;">{{city}}, {{state}} ({{formatDate startDate}} - {{formatDate
              endDate}})</p>
            <div style="color: #4a5568; font-size: 14px; margin-top: 8px;">{{{description}}}</div>
          </div>
          {{/each}}
        </div>
        {{/if}}

        <!-- Education -->
        {{#if education.length}}
        <div style="margin-top: 24px;">
          <h2 style="font-size: 18px; font-weight: bold; color: #4a5568;">Education</h2>
          {{#each education}}
          <div style="margin-top: 16px; border-left: 4px solid #48bb78; padding-left: 16px;">
            <h3 style="font-size: 16px; font-weight: bold;">{{degree}} in {{major}}</h3>
            <p style="color: #718096; font-size: 14px;">{{universityName}} ({{formatDate startDate}} - {{formatDate
              endDate}})</p>
            <p style="color: #4a5568; font-size: 14px;">{{description}}</p>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

      <!-- Right Column -->
      <div style="width: 35%; background-color: #edf2f7; padding: 24px; border-radius: 8px;">
        <img src="{{getImageSrc profilePhoto}}" alt="Profile Photo"
          style="width: 128px; height: 128px; display: block; margin: 0 auto; border-radius: 50%; border: 4px solid #cbd5e0;" />

        <!-- Personal Information -->
        <div style="margin-top: 24px;">
          <h2 style="font-size: 18px; font-weight: bold; color: #4a5568;">Personal Information</h2>
          <p style="color: #4a5568; margin-top: 8px;">{{address}}</p>
        </div>

        <!-- Contact Information -->
        <div style="margin-top: 24px;">
          <h2 style="font-size: 18px; font-weight: bold; color: #4a5568;">Contact Information</h2>
          <p style="color: #4a5568; margin-top: 8px;"><strong>Email:</strong> {{email}}</p>
          <p style="color: #4a5568;"><strong>Phone:</strong> {{phone}}</p>
        </div>

        <!-- Skills -->
        {{#if skills.length}}
        <div style="margin-top: 24px;">
          <h2 style="font-size: 18px; font-weight: bold; color: #4a5568;">Skills</h2>
          <ul style="margin-top: 8px;">
            {{#each skills}}
            <li style="color: #4a5568; display: flex; justify-content: space-between;">
              <span>{{name}}</span>
              <span style="color: #2d3748; font-weight: bold;">{{rating}}/5</span>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
      </div>

    </div>
  </div>
</body>

</html>