<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{firstName}} {{lastName}} | Executive Resume</title>
    <style>
        * {
            box-sizing: border-box;
            overflow-wrap: break-word;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            color: #333;
        }

        .resume {
            width: 100%;
            display: flex;
            min-height: 296mm;
            background: white;
        }

        .sidebar {
            width: 30%;

            background-color: {
                    {
                    themeColor
                }
            }

            ;
            color: white;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .profile-section {
            text-align: center;
        }

        .profile-photo {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 3px solid rgba(255, 255, 255, 0.2);
            object-fit: cover;
            margin: 0 auto;
        }

        .sidebar h3 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            padding-bottom: 5px;
        }

        .contact-info p {
            font-size: 12px;
            margin-bottom: 8px;
        }

        .skill-item {
            margin-bottom: 10px;
        }

        .skill-item span {
            display: block;
            font-size: 11px;
            margin-bottom: 4px;
        }

        .skill-bar-bg {
            height: 5px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
        }

        .skill-bar-fill {
            height: 100%;
            background: white;
            border-radius: 3px;
        }

        .main-content {
            width: 70%;
            padding: 30px;
        }

        .header {
            margin-bottom: 25px;
        }

        .header h1 {
            font-size: 32px;
            font-weight: 800;
            margin: 0 0 5px 0;

            color: {
                    {
                    themeColor
                }
            }

            ;
        }

        .header .job-title {
            font-size: 18px;
            color: #666;
            margin: 0;
        }

        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 12px;
            padding-bottom: 4px;

            border-bottom: 2px solid {
                    {
                    themeColor
                }
            }

            ;
        }

        .experience-item,
        .education-item {
            margin-bottom: 15px;
        }

        .exp-header,
        .edu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3px;
        }

        .exp-title,
        .edu-school {
            font-weight: 700;
            font-size: 14px;
        }

        .exp-date,
        .edu-date {
            font-size: 12px;
            color: #777;
        }

        .exp-company,
        .edu-degree {
            font-style: italic;
            font-size: 13px;
            color: #555;
            margin-bottom: 5px;
        }

        .exp-description,
        .edu-desc {
            font-size: 12px;
            line-height: 1.4;
        }
    </style>
</head>

<body>
    <div class="resume">
        <div class="sidebar">
            <div class="profile-section">
                <img src="{{getImageSrc profilePhoto}}" alt="Profile Photo" class="profile-photo" />
            </div>

            <div class="contact-info">
                <h3>Contact</h3>
                <p>{{phone}}</p>
                <p>{{email}}</p>
                <p>{{address}}</p>
            </div>

            <div class="skills-section">
                <h3>Skills</h3>
                {{#each skills}}
                <div class="skill-item">
                    <span>{{name}}</span>
                    <div class="skill-bar-bg">
                        <div class="skill-bar-fill" style="width:{{rating}}0%"></div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="main-content">
            <header class="header">
                <h1>{{firstName}} {{lastName}}</h1>
                <h2 class="job-title">{{jobTitle}}</h2>
            </header>

            <section class="section">
                <h3 class="section-title">Professional Summary</h3>
                <p style="font-size: 12px;">{{summery}}</p>
            </section>

            {{#if experience.length}}
            <section class="section">
                <h3 class="section-title">Experience</h3>
                {{#each experience}}
                <div class="experience-item">
                    <div class="exp-header">
                        <span class="exp-title">{{title}}</span>
                        <span class="exp-date">{{formatDate startDate}} - {{formatDate endDate}}</span>
                    </div>
                    <div class="exp-company">{{companyName}} | {{city}}, {{state}}</div>
                    <div class="exp-description">{{{description}}}</div>
                </div>
                {{/each}}
            </section>
            {{/if}}

            {{#if education.length}}
            <section class="section">
                <h3 class="section-title">Education</h3>
                {{#each education}}
                <div class="education-item">
                    <div class="edu-header">
                        <span class="edu-school">{{universityName}}</span>
                        <span class="edu-date">{{formatDate startDate}} - {{formatDate endDate}}</span>
                    </div>
                    <div class="edu-degree">{{degree}} in {{major}}</div>
                    <p class="edu-desc">{{description}}</p>
                </div>
                {{/each}}
            </section>
            {{/if}}
        </div>
    </div>
</body>

</html>