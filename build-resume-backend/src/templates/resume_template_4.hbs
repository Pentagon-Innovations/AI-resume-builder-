<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{firstName}} {{lastName}} | Classic Resume</title>
  <style>
    * {
      box-sizing: border-box;
      overflow-wrap: break-word;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #fff;
      margin: 0;
      padding: 0;
      line-height: 1.6;
      color: #1a202c;
    }

    .resume {
      width: 100%;
      background: white;
      padding: 20px;
    }

    .header {
      text-align: center;
      padding-bottom: 20px;
      margin-bottom: 25px;

      border-bottom: 2px solid {
          {
          themeColor
        }
      }

      ;
    }

    .header h1 {
      font-size: 32px;
      margin: 0 0 5px 0;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 800;

      color: {
          {
          themeColor
        }
      }

      ;
    }

    .job-title {
      font-size: 16px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #4a5568;
      margin: 0 0 10px 0;
    }

    .contact-grid {
      display: flex;
      justify-content: center;
      gap: 20px;
      font-size: 12px;
    }

    .section {
      margin-bottom: 25px;
      page-break-inside: avoid;
    }

    .section h2 {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 4px;
      margin-top: 0;
      margin-bottom: 15px;
      font-weight: 700;

      color: {
          {
          themeColor
        }
      }

      ;
    }

    .item {
      margin-bottom: 15px;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      font-weight: bold;
    }

    .item-sub {
      display: flex;
      justify-content: space-between;
      font-style: italic;
      font-size: 13px;
      margin-bottom: 5px;
    }

    .description {
      font-size: 12px;
      margin-top: 5px;
    }

    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill-tag {
      padding: 4px 12px;
      font-size: 11px;
      border-radius: 20px;

      border: 1px solid {
          {
          themeColor
        }
      }

      ;

      color: {
          {
          themeColor
        }
      }

      ;
      font-weight: 500;
      background: #f7fafc;
    }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
  <div class="resume">
    <header class="header">
      <h1>{{firstName}} {{lastName}}</h1>
      <p class="job-title">{{jobTitle}}</p>
      <div class="contact-grid">
        <span>{{phone}}</span>
        <span>{{email}}</span>
        <span>{{address}}</span>
      </div>
    </header>

    <section class="section">
      <h2>Summary</h2>
      <p style="font-size: 12px;">{{summery}}</p>
    </section>

    {{#if experience.length}}
    <section class="section">
      <h2>Experience</h2>
      {{#each experience}}
      <div class="item">
        <div class="item-header">
          <strong>{{title}}</strong>
          <span>{{formatDate startDate}} - {{formatDate endDate}}</span>
        </div>
        <div class="item-sub">
          <span>{{companyName}}</span>
          <span>{{city}}, {{state}}</span>
        </div>
        <div class="description">{{{description}}}</div>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if education.length}}
    <section class="section">
      <h2>Education</h2>
      {{#each education}}
      <div class="item">
        <div class="item-header">
          <strong>{{universityName}}</strong>
          <span>{{formatDate startDate}} - {{formatDate endDate}}</span>
        </div>
        <div class="item-sub">
          <span>{{degree}} in {{major}}</span>
        </div>
        <p class="description">{{description}}</p>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if skills.length}}
    <section class="section">
      <h2>Skills</h2>
      <div class="skills-list">
        {{#each skills}}
        <span class="skill-tag">
          {{name}}
        </span>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </div>
</body>

</html>