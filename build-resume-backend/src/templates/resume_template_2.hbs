<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html>

<head>
  <title>{{firstName}} {{lastName}} | {{jobTitle}} | {{email}}</title>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <meta name="keywords" content="" />
  <meta name="description" content="" />

  <style>
    * {
      box-sizing: border-box;
      overflow-wrap: break-word;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
    }

    .resume {
      width: 100%;
      display: grid;
      grid-template-columns: 30% 70%;
      background: #fff;
      min-height: 296mm;
    }

    .left-column {
      background: #2c3e50;
      color: white;
      padding: 20px;
    }

    .right-column {
      padding: 20px;
    }

    .profile-pic {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid white;
      display: block;
      margin: 0 auto;
      object-fit: cover;
    }

    h2 {
      font-size: 1.5rem;
      margin-top: 15px;
      text-align: center;
    }

    p {
      font-size: 0.85rem;
      margin-bottom: 5px;
    }

    .section {
      margin-bottom: 15px;
      page-break-inside: avoid;
    }

    h3 {
      font-size: 1.1rem;
      margin-top: 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      padding-bottom: 5px;
    }

    .right-column h3 {
      color: #2c3e50;
      border-bottom: 1px solid #eee;
    }

    .skills span {
      display: inline-block;
      background: #1abc9c;
      padding: 4px 8px;
      margin: 2px;
      border-radius: 4px;
      font-size: 11px;
    }
  </style>
  <div class="resume">
    <!-- Left Column -->
    <div class="left-column">
      <img src="{{getImageSrc profilePhoto}}" alt="Profile Picture" class="profile-pic" />
      <h2>{{firstName}} {{lastName}}</h2>
      <p>{{jobTitle}}</p>
      <hr />
      <div class="section">
        <h3>Contact</h3>
        <p>Email: {{email}}</p>
        <p>Phone: {{phone}}</p>
        <p>Address: {{address}}</p>
      </div>
      <div class="section skills">
        <h3>Skills</h3>
        {{#each skills}}
        <span>{{name}}</span>
        {{/each}}
      </div>
    </div>

    <!-- Right Column -->
    <div class="right-column">
      <div class="section">
        <h3>Summary</h3>
        <p>{{summery}}</p>
      </div>
      <div class="section">
        <h3>Work Experience</h3>
        {{#each experience}}
        <div>
          <h4>{{title}} | {{companyName}}</h4>
          <p>{{formatDate startDate}} - {{formatDate endDate}}</p>
          <div>{{{description}}}</div>
        </div>
        {{/each}}
      </div>
      <div class="section">
        <h3>Education</h3>
        {{#each education}}
        <div>
          <h4>{{degree}} in {{major}}</h4>
          <p>{{universityName}} | {{formatDate startDate}} - {{formatDate endDate}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </div>