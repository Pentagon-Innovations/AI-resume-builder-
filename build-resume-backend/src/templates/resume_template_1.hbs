<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Europass Resume</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Open+Sans:wght@300;400;600&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            overflow-wrap: break-word;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .resume {
            width: 100%;
            display: grid;
            grid-template-columns: 32% 68%;
            background: #fff;
        }

        .left-column {
            background: #2c3e50;
            color: white;
            padding: 20px;
        }

        .right-column {
            padding: 20px;
        }

        .profile-pic {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 3px solid white;
            display: block;
            margin: 0 auto;
            object-fit: cover;
        }

        h2 {
            font-size: 1.5rem;
            margin-top: 15px;
            text-align: center;
        }

        p {
            font-size: 0.85rem;
        }

        h3 {
            font-size: 1.1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            padding-bottom: 5px;
            margin-top: 20px;
        }

        .right-column h3 {
            color: #2c3e50;
            border-bottom: 2px solid #eee;
        }

        .section {
            margin-bottom: 15px;
            page-break-inside: avoid;
        }

        .skills span,
        .languages span {
            display: inline-block;
            background: #1abc9c;
            padding: 4px 8px;
            margin: 2px;
            border-radius: 4px;
            font-size: 11px;
        }
    </style>
</head>

<body>
    <div class="resume">
        <!-- Left Column -->
        <div class="left-column">
            <img src="{{getImageSrc profilePhoto}}" alt="Profile Picture" class="profile-pic">
            <h2>{{userName}}</h2>
            <p>{{jobTitle}}</p>
            <hr>
            <div class="section">
                <h3>Contact</h3>
                <p>Email: {{email}}</p>
                <p>Phone: {{phone}}</p>
                <p>Address: {{address}}</p>
            </div>
            <div class="section skills">
                <h3>Skills</h3>
                {{#each skills}}
                <span>{{name}}</span>
                {{/each}}
            </div>
        </div>

        <!-- Right Column -->
        <div class="right-column">
            <div class="section">
                <h3>Summary</h3>
                <p>{{summery}}</p>
            </div>
            <div class="section">
                <h3>Work Experience</h3>
                {{#each experience}}
                <h4>{{title}} | {{companyName}}</h4>
                <p>{{formatDate startDate}} - {{formatDate endDate}}</p>
                {{{description}}}
                {{/each}}
            </div>
            <div class="section">
                <h3>Education</h3>
                {{#each education}}
                <h4>{{degree}} in {{major}}</h4>
                <p>{{universityName}} | {{formatDate startDate}} - {{formatDate endDate}}</p>
                {{/each}}
            </div>
        </div>
    </div>


</body>

</html>